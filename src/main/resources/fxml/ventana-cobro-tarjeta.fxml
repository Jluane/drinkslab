<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../css/estilos-globales.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" fillHeight="false" maxWidth="1.7976931348623157E308" spacing="10.0">
               <children>
                  <AnchorPane style="-fx-background-color: #ddecd6; -fx-background-radius: 5px;">
                     <children>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <image>
                              <Image url="@../img/icons/credit_card_006948.png" />
                           </image>
                        </ImageView>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </AnchorPane>
                  <Label text="Cobro con Tarjeta">
                     <font>
                        <Font name="Lato Bold" size="19.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button cancelButton="true" focusTraversable="false" maxHeight="40.0" maxWidth="40.0" minHeight="29.0" minWidth="29.0" mnemonicParsing="false" onAction="#onActionCancelar" prefHeight="36.0" prefWidth="36.0" styleClass="boton-claro" text="X">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
               <children>
                  <Label text="TOTAL A COBRAR" textFill="#393c38">
                     <font>
                        <Font name="Lato Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalAPagar" alignment="CENTER" contentDisplay="RIGHT" text="\$000.00">
                     <font>
                        <Font name="DejaVu Serif Bold" size="36.0" />
                     </font>
                     <graphic>
                        <Label alignment="BOTTOM_LEFT" contentDisplay="BOTTOM" text="MXN" textFill="#393c38">
                           <font>
                              <Font name="Lato Bold" size="12.0" />
                           </font>
                        </Label>
                     </graphic>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="10.0" style="-fx-background-color: #ddecd6; -fx-background-radius: 6px;">
               <children>
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/icons/contactless_000000.png" />
                     </image>
                  </ImageView>
                  <VBox maxWidth="1.7976931348623157E308" style="-fx-background-color: #ddecd6;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Utiliza la terminal para el cobro" wrapText="true">
                           <font>
                              <Font name="Lato Bold" size="13.0" />
                           </font>
                        </Label>
                        <Label text="Ingresa la cantidad en la terminal y procede con el pago." wrapText="true">
                           <font>
                              <Font name="Lato Regular" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActionPagar" styleClass="boton-generico">
               <graphic>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../img/icons/send_FFFFFF.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="texto-boton-generico" text="Confirmar Cobro">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label styleClass="texto-indicacion-tecla" text="Enter ↵" />
                     </children>
                  </HBox>
               </graphic>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </Button>
            <Label alignment="CENTER" contentDisplay="RIGHT" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" text="Cancelar operación">
               <graphic>
                  <Label style="-fx-text-fill: black;" styleClass="texto-indicacion-tecla" text="ESC" />
               </graphic>
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>

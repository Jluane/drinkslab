<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="5.0" style="-fx-background-color: #ddecd6; -fx-border-radius: 20px; -fx-background-radius: 20px; -fx-border-color: #B5BFB2; -fx-border-width: 1px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/icons/storefront_006948.png" />
         </image>
      </ImageView>
      <Label fx:id="nombre" maxWidth="1.7976931348623157E308" text="Nombre Proveedor">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button focusTraversable="false" mnemonicParsing="false" onAction="#onActionEliminar" opacity="0.55" style="-fx-background-color: transparent;" text="X" />
   </children>
   <padding>
      <Insets bottom="3.0" left="10.0" right="5.0" top="3.0" />
   </padding>
</HBox>
